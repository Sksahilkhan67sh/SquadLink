# SquadLink frontend — public runtime configuration.
#
# Only VITE_-prefixed variables are exposed to the browser bundle by Vite.
# NEVER put secrets here (JWT secrets, DB credentials, LiveKit API secret,
# SMTP credentials, etc.) — anything in this file ships to every client.

# Base URL of the backend REST API (includes /api/v1 prefix handling is
# done by the API client, so just point this at the server origin).
VITE_API_URL=http://localhost:3000

# Socket.IO server origin (same backend, /realtime namespace is appended
# by the client).
VITE_SOCKET_URL=http://localhost:3000

# LiveKit is connected to using a short-lived token minted by the backend
# (see /api/v1/voice/*). The frontend only needs to know which LiveKit
# server to dial — never the API secret.
VITE_LIVEKIT_URL=ws://localhost:7880

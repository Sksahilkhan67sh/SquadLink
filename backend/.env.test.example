# Test overrides. CRITICAL: this must point at a database that is NOT
# development or production — the test suite truncates/reseeds tables
# between runs. `npm test` and `npm run test:integration` load this file
# (see package.json's test scripts / jest setup, and
# docs/database/testing.md). The suite intentionally throws at startup if
# DATABASE_URL doesn't contain "test" as a guardrail against a misconfigured
# environment pointing at a real database — see prisma/test/README.md.

NODE_ENV=test

DATABASE_URL="postgresql://squadlink:squadlink@localhost:5433/squadlink_test?schema=public&connection_limit=5"
REDIS_URL=redis://localhost:6379/1

JWT_ACCESS_SECRET=test-access-secret-needs-to-be-32-characters-min
JWT_REFRESH_SECRET=test-refresh-secret-needs-to-be-32-characters-min

UPLOAD_DRIVER=local
UPLOAD_LOCAL_DIR=./uploads-test

# Development overrides — copy the full variable set from .env.example
# first, then layer these on top for local development. Never commit a
# real .env file.

NODE_ENV=development

# Local Docker Compose Postgres/Redis (see docker-compose.yml).
DATABASE_URL="postgresql://squadlink:squadlink@localhost:5432/squadlink?schema=public&connection_limit=5"
REDIS_URL=redis://localhost:6379

# Short-lived, low-cost secrets are fine for local dev only.
JWT_ACCESS_SECRET=dev-access-secret-do-not-use-in-prod-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-do-not-use-in-prod-32ch

# Local disk instead of S3 by default.
UPLOAD_DRIVER=local

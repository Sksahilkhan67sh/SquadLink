# --- App ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# --- Database (Postgres via Prisma) ---
# connection_limit / pool_timeout tune Prisma's built-in connection pool
# (see docs/database/connection-pooling.md). Default connection_limit is
# num_cpus*2+1 per process — set it explicitly once you know how many
# app instances will share the database's max_connections.
DATABASE_URL="postgresql://squadlink:squadlink@localhost:5433/squadlink?schema=public&connection_limit=10&pool_timeout=10"

# --- JWT ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long-different
JWT_REFRESH_EXPIRES_IN=30d

# --- Redis (integration hook — app boots fine without it) ---
REDIS_URL=redis://localhost:6379

# --- Mail (verification / password reset emails) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="SquadLink <no-reply@squadlink.gg>"

# --- OAuth providers (leave blank to disable a given provider) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:3000/api/v1/auth/discord/callback

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CALLBACK_URL=http://localhost:3000/api/v1/auth/twitch/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback

STEAM_API_KEY=
STEAM_CALLBACK_URL=http://localhost:3000/api/v1/auth/steam/callback
STEAM_REALM=http://localhost:3000

# --- LiveKit (voice) — token generation works locally without these set ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=ws://localhost:7880

# --- Uploads ---
UPLOAD_DRIVER=local
UPLOAD_LOCAL_DIR=./uploads
UPLOAD_MAX_SIZE_MB=10

S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# --- Rate limiting ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

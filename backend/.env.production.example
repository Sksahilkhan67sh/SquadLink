# Production overrides. Real values are provided via your platform's
# secret manager (never a committed .env). Documented here so a new
# environment can be provisioned correctly — see docs/database/backup-and-recovery.md
# and docs/database/connection-pooling.md.

NODE_ENV=production

# sslmode=require (or verify-full with a CA bundle) for managed Postgres.
# connection_limit: set to (max_connections_on_server / number_of_app_instances),
# leaving headroom for migrations/admin connections — do not default to the
# Prisma default of num_cpus*2+1 per instance when running many instances
# against a small managed Postgres plan.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/squadlink?schema=public&sslmode=require&connection_limit=10&pool_timeout=10"

REDIS_URL="rediss://USER:PASSWORD@HOST:6379"

# Rotate regularly; must differ between access/refresh and between environments.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

UPLOAD_DRIVER=s3
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
